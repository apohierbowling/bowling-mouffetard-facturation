# Configuration pour utiliser une base PostgreSQL partagée (mode équipe) au lieu
# de la base SQLite locale par défaut.
#
# Pour un usage LOCAL (chaque poste garde ce fichier) :
#   1. Copiez ce fichier dans un dossier ".streamlit" à côté de app.py :
#        C:\...\Factures\.streamlit\secrets.toml
#      (créez le dossier ".streamlit" s'il n'existe pas)
#   2. Renommez-le "secrets.toml" (sans ".exemple")
#   3. Remplacez la valeur ci-dessous par l'URL de connexion de votre base
#      PostgreSQL (fournie par Supabase, Neon, etc.)
#   4. Relancez l'application
#
# Pour un déploiement sur Streamlit Community Cloud, collez la même ligne
# dans l'onglet "Secrets" des paramètres de votre appli déployée (voir README.md).

DATABASE_URL = "postgresql://utilisateur:mot_de_passe@hote:5432/nom_de_la_base"
